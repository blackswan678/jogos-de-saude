<h1>🧘 MoviPausa</h1><p>Rotina guiada de mobilidade (cerca de 2 min). Siga o ritmo do círculo: inspire ao crescer, expire ao diminuir.</p>
<div id=c></div><h2 id=nm></h2><p id=ds></p><div id=hud></div><button id=b>Começar</button> <button id=sk hidden>Pular</button>
<p class=n>Movimentos suaves, sem dor. Pare se sentir desconforto e, em caso de lesão, consulte um profissional.</p>
<script>
const A=new(window.AudioContext||window.webkitAudioContext)();function beep(f,d=.12,t='sine'){A.resume();const o=A.createOscillator(),g=A.createGain();o.type=t;o.frequency.value=f;g.gain.value=.15;o.connect(g).connect(A.destination);o.start();o.stop(A.currentTime+d)}
const ex=[['Pescoço','🙆','Incline a cabeça devagar para um lado e para o outro.'],['Ombros','🤷','Faça círculos amplos com os ombros, para trás.'],['Punhos','🤲','Gire os punhos nos dois sentidos.'],['Coluna','🧘','Sentado, gire o tronco suavemente para cada lado.'],['Quadril','🚶','Em pé, faça círculos lentos com o quadril.'],['Tornozelos','🦶','Gire cada tornozelo, apoiando-se se precisar.']];
let i,s,iv,pts,ph;
b.onclick=()=>{i=0;pts=0;step()};sk.onclick=()=>{i++;step()};
function step(){clearInterval(iv);if(i>=ex.length)return fim();const[n,e,d]=ex[i];nm.textContent=e+' '+n;ds.textContent=d;s=0;c.className='';void c.offsetWidth;c.className='on';b.hidden=true;sk.hidden=false;iv=setInterval(tick,1000);tick()}
function tick(){if(s>=20){pts+=10;beep(880,.2);i++;return step()}if(s%6==0){ph='Inspire';beep(440)}if(s%6==3){ph='Expire';beep(330)}hud.textContent=`${ph} · ${20-s}s · ${pts} pts`;s++}
function fim(){c.className='';sk.hidden=true;nm.textContent='🏅 Rotina concluída!';ds.textContent=`${pts} pontos · sequência: ${streak()} dia(s)`;hud.textContent='';b.textContent='Repetir';b.hidden=false}
function streak(){try{const d=new Date().toDateString(),o=JSON.parse(localStorage.movi||'{}');if(o.d!=d){o.s=(o.d==new Date(Date.now()-864e5).toDateString()?o.s:0)+1;o.d=d;localStorage.movi=JSON.stringify(o)}return o.s}catch(e){return 1}}
</script>
