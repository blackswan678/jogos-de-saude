<h1>🎯 Campo Visual</h1><p>Olhe sempre para o ponto vermelho, a cerca de 30 cm da tela. Quando enxergar uma bolinha amarela na lateral, toque na tela ou aperte espaço.</p>
<div id=hud></div><canvas id=cv width=600 height=600></canvas><p id=msg></p><button id=b>Começar</button>
<p class=n>Mapa lúdico da sua visão periférica. Não é diagnóstico nem substitui exame oftalmológico.</p>
<script>
const A=new(window.AudioContext||window.webkitAudioContext)();function beep(f,d=.12,t='sine'){A.resume();const o=A.createOscillator(),g=A.createGain();o.type=t;o.frequency.value=f;g.gain.value=.15;o.connect(g).connect(A.destination);o.start();o.stop(A.currentTime+d)}
const x=cv.getContext('2d'),C=300;let pts,k,res,resp,seen;
function base(){x.clearRect(0,0,600,600);x.strokeStyle='#888888';[90,180,270].forEach(r=>{x.beginPath();x.arc(C,C,r,0,7);x.stroke()});x.fillStyle='#ff3b30';x.beginPath();x.arc(C,C,7,0,7);x.fill()}
function dot(p,col){const a=p.a*Math.PI/4;x.fillStyle=col;x.beginPath();x.arc(C+Math.cos(a)*p.r*90,C+Math.sin(a)*p.r*90,12,0,7);x.fill()}
b.onclick=()=>{pts=[];for(let a=0;a<8;a++)for(let r=1;r<=3;r++)pts.push({a,r});pts.sort(()=>Math.random()-.5);k=0;res=[];msg.textContent='';b.hidden=true;go()};
function go(){if(k>=pts.length)return fim();hud.textContent=`Ponto ${k+1} de ${pts.length}`;base();
setTimeout(()=>{dot(pts[k],'#ffd60a');seen=false;resp=true;setTimeout(()=>{base();setTimeout(()=>{resp=false;res.push({...pts[k],s:seen});k++;go()},900)},300)},600+Math.random()*900)}
function hit(){if(resp&&!seen){seen=true;beep(660,.06)}}
cv.addEventListener('pointerdown',hit);addEventListener('keydown',e=>{if(e.code=='Space'){e.preventDefault();hit()}});
function fim(){base();res.forEach(p=>dot(p,p.s?'#30d158':'#ff453a'));hud.textContent='';const n=res.filter(p=>p.s).length;msg.textContent=`Você percebeu ${n} de ${res.length} pontos. Verde: visto · Vermelho: não visto (pode ter sido distração; repita o teste).`;b.textContent='Jogar de novo';b.hidden=false}
</script>
