<div class=p><i></i><button data-k=3 aria-label=cima>⬆️</button><i></i><button data-k=2 aria-label=esquerda>⬅️</button><i></i><button data-k=0 aria-label=direita>➡️</button><i></i><button data-k=1 aria-label=baixo>⬇️</button><i></i></div>
