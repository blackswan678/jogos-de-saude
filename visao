<script>
const A=new(window.AudioContext||window.webkitAudioContext)();function beep(f,d=.12,t='sine'){A.resume();const o=A.createOscillator(),g=A.createGain();o.type=t;o.frequency.value=f;g.gain.value=.15;o.connect(g).connect(A.destination);o.start();o.stop(A.currentTime+d)}
let sz,lives,hit,rot,on=false;
b.onclick=()=>{sz=120;lives=3;hit=null;on=true;msg.textContent='';b.hidden=true;e.hidden=false;round()};
function round(){rot=Math.floor(Math.random()*4);e.style.fontSize=sz+'px';e.style.transform=`rotate(${rot*90}deg)`;hud.textContent=`Tamanho ${Math.round(sz)} px · Vidas ${'❤️'.repeat(lives)}`}
function ans(k){if(!on)return;if(k==rot){beep(660);hit=sz;sz*=.82}else{beep(180,.25,'sawtooth');lives--}if(lives<1)return fim();round()}
function fim(){on=false;e.hidden=true;hud.textContent='';msg.textContent=`Fim! Menor tamanho identificado: ${hit?Math.round(hit)+' px':'—'}. Quanto menor, melhor.`;b.textContent='Jogar de novo';b.hidden=false}
document.querySelectorAll('.p button').forEach(x=>x.onclick=()=>ans(+x.dataset.k));
addEventListener('keydown',ev=>{const m={ArrowRight:0,ArrowDown:1,ArrowLeft:2,ArrowUp:3};if(ev.key in m){ev.preventDefault();ans(m[ev.key])}});
</script>
# Optotipo E

Jogo de saúde visual: teste lúdico de acuidade com o E de Snellen.

🔗 **Jogo online:** https://SEU-USUARIO.github.io/optotipo/

## Como jogar
Indique para onde a abertura do E aponta, com botões ou setas do teclado. A letra diminui a cada acerto. Você tem 3 vidas.

## Tecnologias
HTML + CSS + JavaScript puro, sem bibliotecas. Sons sintetizados com a Web Audio API (OscillatorNode), sem arquivos de áudio. Publicado com GitHub Pages (branch main, pasta raiz).

## Aviso
Jogo lúdico e educativo. Não é diagnóstico e não substitui avaliação de um profissional de saúde.

